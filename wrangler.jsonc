{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-center-cr",
  // Cuenta Atlas Center (migrado desde "Liga Hispana AO4" el 2026-10-13).
  "account_id": "303677174b3b78313fc57a7633b1b41b",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "404-page",
    // Sin barra final: /equipo responde 200 directamente. Con el
    // "auto-trailing-slash" por defecto Cloudflare devolvía 307 hacia
    // /equipo/, así que todos los enlaces internos del sitio pasaban por una
    // redirección temporal y Google las reportaba como "página con redirección".
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
